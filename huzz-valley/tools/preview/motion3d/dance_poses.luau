-- Picks each dance's most telling moment (its "pose") for the Dances cards, and films all 25 frozen in it.
-- The pose = the moment the hands, feet and head are furthest from standing still (hands count most), away from
-- the first and last tenth (where dances ease in and out). Writes Shared/Config/DancePoses.lua.
-- From the repo root: sh huzz-valley/tools/preview/motion3d/video.sh huzz-valley/tools/preview/motion3d/dance_poses.luau out.mp4
local fs = require("@lune/fs")
local roblox = require("@lune/roblox")
local CFrame, Vector3 = roblox.CFrame, roblox.Vector3
local Rig = require("./rig")
local Scene = require("./scene")
local KFS = require("./kfs")

local folder = roblox.deserializeModel(fs.readFile("huzz-valley/src/ServerStorage/HuzzAnimations.rbxm"))[1]
local names = {}
for _, seq in folder:GetChildren() do
	if seq.Name:find("^Dance_") then table.insert(names, seq.Name) end
end
table.sort(names)

local WEIGHT = { LeftHand = 1.5, RightHand = 1.5, LeftFoot = 1, RightFoot = 1, Head = 0.6 }
local function points(rig)
	local out = {}
	for n in WEIGHT do out[n] = rig.root.CFrame:PointToObjectSpace(rig.parts[n].CFrame.Position) end
	return out
end
local probe = Rig.r15("Probe")
probe.root.CFrame = CFrame.new(0, Rig.REST_HEIGHT, 0)
Rig.fk(probe)
local rest = points(probe)

local scene = Scene.new()
local PER_ROW = 5
local poses, lines = {}, {}
for i, name in names do
	local anim = KFS.load(folder:FindFirstChild(name))
	local best, bestT = -1, 0
	local t = anim.length * 0.1
	while t <= anim.length * 0.9 do
		KFS.apply(anim, probe, t)
		Rig.fk(probe)
		local score = 0
		for n, p in points(probe) do score += (p - rest[n]).Magnitude * WEIGHT[n] end
		if score > best then best, bestT = score, t end
		t += 1 / 30
	end
	local id = name:sub(7)
	poses[i] = { anim = anim, t = bestT }
	table.insert(lines, string.format("\t%s = %.2f,", id, bestT))
	local rig = scene:addRig(Rig.r15(id, { shirt = "#3a6fd8", pants = "#22232c" }))
	local col, row = (i - 1) % PER_ROW, (i - 1) // PER_ROW
	rig.root.CFrame = Rig.lookAt(Vector3.new((col - 2) * 5, Rig.REST_HEIGHT, row * 6), Vector3.new((col - 2) * 5, Rig.REST_HEIGHT, row * 6 - 1))
	poses[i].rig = rig
	print(string.format("%-22s pose at %.2f s of %.2f", name, bestT, anim.length))
end
fs.writeFile("huzz-valley/src/ReplicatedStorage/Shared/Config/DancePoses.lua", "--!strict\n-- Generated by tools/preview/motion3d/dance_poses.luau: the second of each dance its card freezes on (its most\n-- telling moment). Re-run it when the dances change.\nreturn {\n" .. table.concat(lines, "\n") .. "\n}\n")
for f = 0, 14 do
	for _, p in poses do
		KFS.apply(p.anim, p.rig, p.t)
		Rig.fk(p.rig)
	end
	scene:frame(Vector3.new(0, 30, -14), Vector3.new(0, 1, 12))
end
scene:save(nil, 30, 1280, 960)
