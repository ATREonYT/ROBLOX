-- lune run tests/SetupLobbyProps.spec.luau   (from huzz-valley/)
-- The owner's Studio prop setup (ServerStorage/HuzzStudioTools/SetupLobbyProps, generated by tools/props/bake_props.py)
-- on a fake import of design/lobby/Lobby_Props.glb: Studio may turn (a quarter turn at a time), scale and move an
-- import, and adds digits to part names. Every prop must come out in ServerStorage/HuzzLobbyProps/<key>: Root in the
-- middle of its box, 1 stud per .glb unit, the parts where the .glb has them, glowing parts Neon in their colour,
-- every part welded to the Root, and a stand-in on a pad swapped for it at the stand-in's place and size.
local fs = require("@lune/fs")
local luau = require("@lune/luau")
local roblox = require("@lune/roblox")
local Instance, Vector3, CFrame, Color3, Enum = roblox.Instance, roblox.Vector3, roblox.CFrame, roblox.Color3, roblox.Enum
local ROOT = if fs.isDir("huzz-valley") then "huzz-valley/" else ""

for _, class in { "BasePart", "Part", "MeshPart" } do -- (Lune doesn't ship Position)
	pcall(function()
		roblox.implementProperty(class, "Position", function(self) return self.CFrame.Position end, function(self, v)
			self.CFrame = self.CFrame - self.CFrame.Position + v
		end)
	end)
end

-- Studio's Model pivot and scale (Lune has neither): the pivot is the PrimaryPart's CFrame; ScaleTo scales every
-- part's size and its offset from the pivot
local function partsIn(m)
	local list = {}
	for _, d in m:GetDescendants() do if d:IsA("BasePart") then table.insert(list, d) end end
	return list
end
roblox.implementMethod("Model", "GetPivot", function(self)
	return if self.PrimaryPart then self.PrimaryPart.CFrame else CFrame.new()
end)
roblox.implementMethod("Model", "PivotTo", function(self, cf)
	local from = self:GetPivot()
	for _, p in partsIn(self) do p.CFrame = cf * from:ToObjectSpace(p.CFrame) end
end)
roblox.implementMethod("Model", "GetScale", function(self) return self:GetAttribute("__scale") or 1 end)
roblox.implementMethod("Model", "ScaleTo", function(self, s)
	local k = s / self:GetScale()
	local pivot = self:GetPivot()
	for _, p in partsIn(self) do
		local rel = pivot:ToObjectSpace(p.CFrame)
		p.Size *= k
		p.CFrame = pivot * (rel - rel.Position + rel.Position * k)
	end
	self:SetAttribute("__scale", s)
end)

local passed, failed = 0, 0
local function check(name, cond)
	if cond then passed += 1 else failed += 1; print("FAIL " .. name) end
end

local game = Instance.new("DataModel")
local Workspace, ServerStorage = game:GetService("Workspace"), game:GetService("ServerStorage")
local source = fs.readFile(ROOT .. "src/ServerStorage/HuzzStudioTools/SetupLobbyProps.lua")
source = string.gsub(source, "if script == nil then run%(%) end[^\n]*\n", "")
source = string.gsub(source, "return run%s*$", "return run, PROPS")
local lines = {}
local env = { game = game, Instance = Instance, Vector3 = Vector3, CFrame = CFrame, Color3 = Color3, Enum = Enum,
	print = function(s) table.insert(lines, s) end, warn = function(s) table.insert(lines, "WARN " .. tostring(s)) end }
local run, PROPS = luau.load(source, { debugName = "SetupLobbyProps", environment = env })()
check("5 props baked in", #PROPS == 5)

-- the fake import: Workspace > Lobby_Props > <prop> > parts named like the .glb nodes (Studio's digits on some)
local all = Instance.new("Model")
all.Name = "Lobby_Props"
all.Parent = Workspace
local truth = {}
for i, p in PROPS do
	local yaw = (i % 4) * math.pi / 2
	local turn = CFrame.Angles(0, yaw, 0)
	local s = 2 + i * 0.7 -- studs per .glb unit, as the importer chose
	local at = Vector3.new(i * 30, 3, -i * 7)
	local m = Instance.new("Model")
	m.Name = string.gsub(p.key, "_", " ") -- (found by name whatever the spacing)
	m.Parent = all
	for j, n in p.nodes do
		local part = Instance.new("Part")
		part.Name = if j % 3 == 0 then n[1] .. "2" else n[1]
		part.Size = Vector3.new(0.2, 0.2, 0.2) * s
		part.CFrame = CFrame.new(at + turn:VectorToWorldSpace(Vector3.new(n[2], n[3], n[4]) * s)) * turn.Rotation
		part.Parent = m
	end
	truth[p.key] = { p = p, turn = turn, s = s, at = at }
end

-- a stand-in on a pad, like the game's (Workspace > HuzzLobbyProps > LobbyProp > Prop, Scale 2, turned to face in)
local placed = Instance.new("Folder")
placed.Name = "HuzzLobbyProps"
placed.Parent = Workspace
local lp = Instance.new("Model")
lp.Name = "LobbyProp"
lp:SetAttribute("Prop", "Shop_Stall")
lp:SetAttribute("Scale", 2)
lp.Parent = placed
local old = Instance.new("Model")
old.Name = "Prop"
old:SetAttribute("StandIn", true)
old.Parent = lp
local oldRoot = Instance.new("Part")
oldRoot.Name = "Root"
oldRoot.Anchored = true
local standAt = CFrame.new(-150, 16, -6) * CFrame.Angles(0, math.pi, 0)
oldRoot.CFrame = standAt
oldRoot.Parent = old
old.PrimaryPart = oldRoot
Instance.new("ParticleEmitter").Parent = oldRoot
Instance.new("ClickDetector").Parent = old

local ok, count = pcall(run)
check("the setup runs (" .. tostring(count) .. ")", ok and count == 5)
if not ok then print(count) end
local holder = ServerStorage:FindFirstChild("HuzzLobbyProps")
check("ServerStorage/HuzzLobbyProps made", holder ~= nil)
local done = false
for _, l in lines do
	if string.find(l, "Done: 5 of 5", 1, true) then done = true end
	if string.find(l, "WARN") or string.find(l, "roughly") or string.find(l, "didn't match") then print("  " .. l) end
end
check("Done: 5 of 5", done)
check("the import is tidied away", all.Parent == nil)

for key, t in truth do
	local p = t.p
	local model = holder and holder:FindFirstChild(key)
	check(key .. ": set up", model ~= nil)
	if model then
		local root = model:FindFirstChild("Root")
		check(key .. ": Root is the PrimaryPart, anchored", root and model.PrimaryPart == root and root.Anchored)
		if root then
			check(key .. ": Root is the prop's box, 1 stud a unit", (root.Size - Vector3.new(p.size[1], p.size[2], p.size[3])).Magnitude < 0.01)
			-- each part where the .glb has it, relative to the Root (the box's middle, its axes the .glb's)
			local worst, n, welded, neon, glows, plainNeon = 0, 0, 0, 0, 0, 0
			for _, part in model:GetChildren() do
				if part:IsA("BasePart") and part ~= root then
					n += 1
					local name = part.Name
					local node
					for _, nd in p.nodes do
						if nd[1] == name or nd[1] .. "2" == name then node = nd end
					end
					if node then
						local rel = root.CFrame:PointToObjectSpace(part.CFrame.Position)
						worst = math.max(worst, (rel - Vector3.new(node[2], node[3] - p.size[2] / 2, node[4])).Magnitude)
						if node[6] == 1 then
							glows += 1
							if part.Material == Enum.Material.Neon and part.Color:ToHex():lower() == node[5] then neon += 1 end
						elseif part.Material == Enum.Material.Neon then
							plainNeon += 1
						end
					end
					local w = part:FindFirstChildOfClass("WeldConstraint")
					if w and w.Part0 == root and not part.Anchored then welded += 1 end
				end
			end
			check(key .. ": every part kept (" .. n .. ")", n == #p.nodes)
			check(key .. ": parts where the .glb has them (worst " .. string.format("%.3f", worst) .. ")", worst < 0.02)
			check(key .. ": glowing parts Neon in their colour", neon == glows)
			check(key .. ": the other parts aren't Neon", plainNeon == 0)
			check(key .. ": every part welded to the Root", welded == n)
		end
	end
end

-- the stand-in on the pad is now his model, at the same spot, the pad's size, keeping the sparkles and the click
local prop = lp:FindFirstChild("Prop")
check("the pad's stand-in is swapped", prop and prop ~= old and prop:GetAttribute("StandIn") == false)
if prop and prop.PrimaryPart then
	check("swapped in at the stand-in's spot and turn", (prop.PrimaryPart.CFrame.Position - standAt.Position).Magnitude < 0.01
		and prop.PrimaryPart.CFrame.LookVector:Dot(standAt.LookVector) > 0.999)
	check("the pad's sparkles and click kept", prop.PrimaryPart:FindFirstChildOfClass("ParticleEmitter") ~= nil and prop:FindFirstChildOfClass("ClickDetector") ~= nil)
	local s = truth.Shop_Stall.p.size
	check("scaled to the pad's Scale", (prop.PrimaryPart.Size - Vector3.new(s[1], s[2], s[3]) * 2).Magnitude < 0.02)
end

-- running it again with nothing new imported keeps them
lines = {}
local ok2, count2 = pcall(run)
check("a second run keeps all 5", ok2 and count2 == 5 and #holder:GetChildren() == 5)

print(string.format("SetupLobbyProps: %d ok, %d failed", passed, failed))
if failed > 0 then
	require("@lune/process").exit(1)
end
