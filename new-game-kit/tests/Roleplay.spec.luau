--!nonstrict
-- New Game Kit spec: Roleplay rules (jobs, paychecks, houses, cars, props, jail). Vault note 26.
local ServerScriptService = game:GetService("ServerScriptService")
local Roleplay = require(ServerScriptService:WaitForChild("Kit"):WaitForChild("Roleplay"))

local JOBS = {
	Police = { pay = 60, cap = 2 },
	Medic = { pay = 55, cap = 2 },
	Citizen = { pay = 15 },
}

return function()
	describe("Roleplay", function()
		it("caps jobs so the town stays balanced", function()
			expect((Roleplay.CanJoin(JOBS, "Police", { Police = 1 }))).to.equal(true)
			expect(select(2, Roleplay.CanJoin(JOBS, "Police", { Police = 2 }))).to.equal("Full")
			expect((Roleplay.CanJoin(JOBS, "Citizen", { Citizen = 99 }))).to.equal(true)
			expect(select(2, Roleplay.CanJoin(JOBS, "Pirate", {}))).to.equal("Unknown")
			expect(select(2, Roleplay.CanJoin(JOBS, "Medic", {}, "Medic"))).to.equal("Already")
		end)
		it("pays for work seen by the server, never for time online", function()
			local amount, why = Roleplay.Paycheck(JOBS.Medic, 100, 250)
			expect(amount).to.equal(55)
			expect(why).to.equal("Working")
			amount, why = Roleplay.Paycheck(JOBS.Medic, 100, 400)
			expect(amount).to.equal(0)
			expect(why).to.equal("NotWorking")
			expect((Roleplay.Paycheck(JOBS.Police, nil, 400))).to.equal(0)
		end)
		it("gives one house per player, and only the owner can lock it", function()
			local book = Roleplay.Houses.new({ "A", "B" })
			expect((book:Claim(1, "A"))).to.equal(true)
			expect(select(2, book:Claim(1, "B"))).to.equal("HasHouse")
			expect(select(2, book:Claim(2, "A"))).to.equal("Taken")
			expect(select(2, book:SetLocked(2, "A", true))).to.equal("NotOwner")
			expect((book:SetLocked(1, "A", true))).to.equal(true)
			expect(book:CanEnter(2, "A")).to.equal(false)
			expect(book:CanEnter(1, "A")).to.equal(true)
		end)
		it("lets guests in, and kicking removes the invite", function()
			local book = Roleplay.Houses.new({ "A" })
			book:Claim(1, "A")
			book:SetLocked(1, "A", true)
			book:AddGuest(1, "A", 2)
			expect(book:CanEnter(2, "A")).to.equal(true)
			expect(book:Kick(1, "A", 2)).to.equal(true)
			expect(book:CanEnter(2, "A")).to.equal(false)
			expect(book:Kick(3, "A", 2)).to.equal(false)
		end)
		it("frees the house and the guest lists when a player leaves", function()
			local book = Roleplay.Houses.new({ "A", "B" })
			book:Claim(1, "A")
			book:Claim(2, "B")
			book:SetLocked(2, "B", true)
			book:AddGuest(2, "B", 1)
			book:Release(1)
			expect(book:OwnerOf("A")).to.equal(nil)
			expect(book:CanEnter(1, "B")).to.equal(false)
			expect((book:Claim(3, "A"))).to.equal(true)
		end)
		it("keeps cars to one each, a server cap and a cooldown", function()
			expect(select(2, Roleplay.CanSpawnVehicle({ mine = 0, server = 0 }, 0))).to.equal("Ok")
			expect(select(2, Roleplay.CanSpawnVehicle({ mine = 1, server = 3, lastSpawn = 0 }, 20))).to.equal("Replace")
			expect(select(2, Roleplay.CanSpawnVehicle({ mine = 0, server = 3, lastSpawn = 15 }, 20))).to.equal("Wait")
			expect(select(2, Roleplay.CanSpawnVehicle({ mine = 0, server = 20 }, 99))).to.equal("ServerFull")
		end)
		it("caps props and never jails anyone for long", function()
			expect((Roleplay.CanPlaceProp(39))).to.equal(true)
			expect(select(2, Roleplay.CanPlaceProp(40))).to.equal("PropLimit")
			expect(Roleplay.JailSeconds(9999)).to.equal(60)
			expect(Roleplay.JailSeconds(-5)).to.equal(10)
			expect(Roleplay.JailSeconds(0 / 0)).to.equal(10)
			expect(Roleplay.JailSeconds(30)).to.equal(30)
		end)
	end)
end
