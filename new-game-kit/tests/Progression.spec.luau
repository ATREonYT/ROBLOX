--!nonstrict
-- New Game Kit spec: Progression (small levels toward one goal, level-up streaks).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Progression = require(ReplicatedStorage:WaitForChild("Kit"):WaitForChild("Progression"))

return function()
	describe("Progression.Level", function()
		it("starts at level 1 and ends at MAX exactly at the goal", function()
			expect(Progression.Level(0, 30)).to.equal(1)
			expect(Progression.Level(29, 30)).to.equal(19)
			expect(Progression.Level(30, 30)).to.equal(20)
			expect(Progression.Level(500, 30)).to.equal(20)
		end)
		it("climbs one level at a time and never goes back", function()
			local last = 1
			for have = 0, 1000 do
				local level = Progression.Level(have, 1000)
				expect(level >= last).to.equal(true)
				expect(level - last <= 1).to.equal(true)
				last = level
			end
			expect(last).to.equal(20)
		end)
		it("grows level sizes slowly (curve > 1)", function()
			local first = Progression.LevelStart(1000, 3) - Progression.LevelStart(1000, 2)
			local late = Progression.LevelStart(1000, 20) - Progression.LevelStart(1000, 19)
			expect(late > first).to.equal(true)
			expect(late < first * 3).to.equal(true)
		end)
		it("reports progress inside the level", function()
			local level, into, size = Progression.Level(0, 1000)
			expect(level).to.equal(1)
			expect(into).to.equal(0)
			expect(size).to.equal(Progression.LevelStart(1000, 2))
			local _, _, maxSize = Progression.Level(1000, 1000)
			expect(maxSize).to.equal(0)
		end)
		it("counts levels crossed in one tick", function()
			expect(Progression.LevelsGained(0, 1000, 1000)).to.equal(19)
			expect(Progression.LevelsGained(500, 400, 1000)).to.equal(0)
		end)
	end)
	describe("Progression.Streak", function()
		it("counts hits inside the window and resets after a gap", function()
			local s = Progression.Streak(1.5)
			expect(s:Hit(0)).to.equal(1)
			expect(s:Hit(1)).to.equal(2)
			expect(s:Hit(2.4)).to.equal(3)
			expect(s:Hit(5)).to.equal(1)
			expect(s:Hit(5.5, 3)).to.equal(4)
			s:Reset()
			expect(s:Hit(6)).to.equal(1)
		end)
	end)
end
