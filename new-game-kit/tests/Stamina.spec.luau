--!nonstrict
-- New Game Kit spec: Stamina (sprint drain, regen delay, exhaustion). Vault "Realistic City RP/05".
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Stamina = require(ReplicatedStorage:WaitForChild("Kit"):WaitForChild("Stamina"))

return function()
	describe("Stamina", function()
		it("sprints for 8 seconds, then makes you walk until 30% is back", function()
			local s = Stamina.new()
			expect(Stamina.Step(s, 1, true, true)).to.equal(24)
			expect(s.value).to.be.near(87.5)
			for _ = 1, 7 do
				Stamina.Step(s, 1, true, true)
			end
			expect(s.value).to.equal(0)
			expect(s.exhausted).to.equal(true)
			expect(Stamina.Step(s, 1, true, true)).to.equal(16)
			expect(s.value).to.be.near(10)
			expect(s.exhausted).to.equal(true)
			Stamina.Step(s, 1, false, false)
			expect(s.value).to.be.near(30)
			expect(s.exhausted).to.equal(false)
			expect(Stamina.Step(s, 0.1, true, true)).to.equal(24)
		end)
		it("waits a moment after spending before it refills", function()
			local s = Stamina.new()
			expect(Stamina.Spend(s, 20)).to.equal(true)
			Stamina.Step(s, 0.5, false, false)
			expect(s.value).to.be.near(80)
			Stamina.Step(s, 0.5, false, false)
			expect(s.value).to.be.near(90)
		end)
		it("never sprints standing still, and a frame hitch can't empty the bar", function()
			local s = Stamina.new()
			expect(Stamina.Step(s, 1, true, false)).to.equal(16)
			expect(s.value).to.equal(100)
			Stamina.Step(s, 100, true, true)
			expect(s.value).to.be.near(87.5)
		end)
		it("refuses a spend it can't afford", function()
			local s = Stamina.new()
			s.value = 5
			expect(Stamina.Spend(s, 10)).to.equal(false)
			expect(s.value).to.equal(5)
		end)
	end)
end
