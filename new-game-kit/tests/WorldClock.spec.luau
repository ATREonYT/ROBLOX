--!nonstrict
-- New Game Kit spec: WorldClock (shared day/night, street lights, store hours). Vault "Realistic City RP/09".
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local WorldClock = require(ReplicatedStorage:WaitForChild("Kit"):WaitForChild("WorldClock"))

return function()
	describe("WorldClock", function()
		it("starts in the morning: a 14-minute day and a 6-minute night", function()
			expect(WorldClock.ClockTime(0)).to.be.near(8)
			expect(WorldClock.ClockTime(700)).to.be.near(18)
			expect(WorldClock.ClockTime(880)).to.be.near(0, 1e-6)
			expect(WorldClock.ClockTime(1060)).to.be.near(6)
			expect(WorldClock.ClockTime(1060 + 1200)).to.be.near(6)
		end)
		it("switches street lights with a small band so they never flicker", function()
			expect(WorldClock.IsNight(20)).to.equal(true)
			expect(WorldClock.IsNight(12)).to.equal(false)
			expect(WorldClock.IsNight(18.3, false)).to.equal(false)
			expect(WorldClock.IsNight(18.3, true)).to.equal(true)
			expect(WorldClock.IsNight(6.55, true)).to.equal(true)
			expect(WorldClock.IsNight(6.7, true)).to.equal(false)
		end)
		it("opens stores on their hours, wrapping midnight", function()
			expect(WorldClock.IsOpen("24/7", 3)).to.equal(true)
			local shop = { open = 9, close = 17 }
			expect(WorldClock.IsOpen(shop, 8)).to.equal(false)
			expect(WorldClock.IsOpen(shop, 9)).to.equal(true)
			expect(WorldClock.IsOpen(shop, 17)).to.equal(false)
			local club = { open = 20, close = 4 }
			expect(WorldClock.IsOpen(club, 23)).to.equal(true)
			expect(WorldClock.IsOpen(club, 3)).to.equal(true)
			expect(WorldClock.IsOpen(club, 12)).to.equal(false)
		end)
		it("labels the phone clock", function()
			expect(WorldClock.Label(21 + 41 / 60)).to.equal("9:41 PM")
			expect(WorldClock.Label(0)).to.equal("12:00 AM")
			expect(WorldClock.Label(12.5)).to.equal("12:30 PM")
		end)
	end)
end
