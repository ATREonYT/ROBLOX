--!nonstrict
-- New Game Kit spec: Format (big numbers, clocks).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Format = require(ReplicatedStorage:WaitForChild("Kit"):WaitForChild("Format"))

return function()
	describe("Format.Short", function()
		it("keeps small numbers whole", function()
			expect(Format.Short(0)).to.equal("0")
			expect(Format.Short(999)).to.equal("999")
			expect(Format.Short(12.9)).to.equal("12")
		end)
		it("abbreviates and never rounds up", function()
			expect(Format.Short(1000)).to.equal("1K")
			expect(Format.Short(1530)).to.equal("1.53K")
			expect(Format.Short(1999)).to.equal("1.99K")
			expect(Format.Short(100000)).to.equal("100K")
			expect(Format.Short(25_500_000)).to.equal("25.5M")
			expect(Format.Short(12e12)).to.equal("12T")
		end)
		it("handles NaN and negatives", function()
			expect(Format.Short(0 / 0)).to.equal("0")
			expect(Format.Short(-1500)).to.equal("-1.5K")
		end)
	end)
	describe("Format.Clock", function()
		it("formats minutes and hours", function()
			expect(Format.Clock(75)).to.equal("1:15")
			expect(Format.Clock(3725)).to.equal("1:02:05")
			expect(Format.Clock(-3)).to.equal("0:00")
		end)
	end)
end
