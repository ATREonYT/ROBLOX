--!nonstrict
-- New Game Kit spec: Wallet (cash + bank, caps, ledger). Vault "Realistic City RP/02".
local ServerScriptService = game:GetService("ServerScriptService")
local Wallet = require(ServerScriptService:WaitForChild("Kit"):WaitForChild("Wallet"))

return function()
	describe("Wallet", function()
		it("repairs a missing or corrupt saved wallet", function()
			local w = Wallet.new({ cash = -5, bank = 0 / 0 })
			expect(w.cash).to.equal(0)
			expect(w.bank).to.equal(0)
			expect(Wallet.new(nil).cash).to.equal(0)
			expect(Wallet.new({ cash = 12.7, bank = 3 }).cash).to.equal(12)
		end)
		it("earns into the bank, only for named reasons, only whole positive amounts", function()
			local w = Wallet.new({})
			expect((Wallet.Earn(w, 100, "Paycheck", 0))).to.equal(true)
			expect(w.bank).to.equal(100)
			expect(select(2, Wallet.Earn(w, 100, "FreeMoney", 0))).to.equal("UnknownReason")
			expect(select(2, Wallet.Earn(w, 1.5, "Job", 0))).to.equal("BadAmount")
			expect(select(2, Wallet.Earn(w, -10, "Job", 0))).to.equal("BadAmount")
			expect(select(2, Wallet.Earn(w, 0 / 0, "Job", 0))).to.equal("BadAmount")
			expect(select(2, Wallet.Earn(w, math.huge, "Job", 0))).to.equal("BadAmount")
			expect(select(2, Wallet.Earn(w, 20_000_000, "Refund", 0))).to.equal("TooBig")
			expect((Wallet.Earn(w, 50, "Pickup", 0, "cash"))).to.equal(true)
			expect(w.cash).to.equal(50)
		end)
		it("caps each faucet per rolling hour", function()
			local w = Wallet.new({})
			expect((Wallet.Earn(w, 100, "Paycheck", 0))).to.equal(true)
			expect(select(2, Wallet.Earn(w, 19_950, "Paycheck", 10))).to.equal("CapReached")
			expect((Wallet.Earn(w, 19_900, "Paycheck", 10))).to.equal(true)
			expect(select(2, Wallet.Earn(w, 1, "Paycheck", 3599))).to.equal("CapReached")
			expect((Wallet.Earn(w, 100, "Paycheck", 3600))).to.equal(true)
		end)
		it("pays with cash, card or cash-then-card, never below zero", function()
			local w = Wallet.new({ cash = 30, bank = 100 })
			expect((Wallet.Pay(w, 50, "any", "Store", 1))).to.equal(true)
			expect(w.cash).to.equal(0)
			expect(w.bank).to.equal(80)
			expect(select(2, Wallet.Pay(w, 100, "card", "Store", 1))).to.equal("NotEnoughBank")
			expect(select(2, Wallet.Pay(w, 1, "cash", "Store", 1))).to.equal("NotEnoughCash")
			expect(select(2, Wallet.Pay(w, 81, "any", "Store", 1))).to.equal("NotEnough")
			expect(select(2, Wallet.Pay(w, 1, "crypto", "Store", 1))).to.equal("BadMethod")
			expect(w.bank).to.equal(80)
		end)
		it("deposits and withdraws between pockets", function()
			local w = Wallet.new({ cash = 500, bank = 0 })
			expect((Wallet.Deposit(w, 400, 1))).to.equal(true)
			expect(w.cash).to.equal(100)
			expect(w.bank).to.equal(400)
			expect(select(2, Wallet.Deposit(w, 101, 1))).to.equal("NotEnoughCash")
			expect((Wallet.Withdraw(w, 400, 1))).to.equal(true)
			expect(w.cash).to.equal(500)
			expect(select(2, Wallet.Withdraw(w, 1, 1))).to.equal("NotEnoughBank")
		end)
		it("transfers bank to bank with a daily cap and no self-transfers", function()
			local a = Wallet.new({ cash = 0, bank = 60_000 })
			local b = Wallet.new({})
			expect(select(2, Wallet.Transfer(a, a, 10, 0))).to.equal("Self")
			expect((Wallet.Transfer(a, b, 50_000, 0))).to.equal(true)
			expect(b.bank).to.equal(50_000)
			expect(select(2, Wallet.Transfer(a, b, 1, 100))).to.equal("DailyCap")
			expect((Wallet.Transfer(a, b, 1, 86_400))).to.equal(true)
			expect(Wallet.Total(a) + Wallet.Total(b)).to.equal(60_000)
		end)
		it("drops 10% of pocket cash on a knockout, capped, never bank money", function()
			local w = Wallet.new({ cash = 1000, bank = 9999 })
			expect(Wallet.KnockoutDrop(w, 1)).to.equal(100)
			expect(w.cash).to.equal(900)
			expect(w.bank).to.equal(9999)
			local rich = Wallet.new({ cash = 100_000, bank = 0 })
			expect(Wallet.KnockoutDrop(rich, 1)).to.equal(5000)
			expect(Wallet.KnockoutDrop(Wallet.new({ cash = 5 }), 1)).to.equal(0)
		end)
		it("keeps a short ledger", function()
			local w = Wallet.new({ cash = 1000 })
			for i = 1, 80 do
				Wallet.Deposit(w, 1, i)
			end
			expect(#w.ledger).to.equal(Wallet.Rules.ledgerSize)
			expect(w.ledger[#w.ledger].kind).to.equal("Deposit")
		end)
	end)
end
