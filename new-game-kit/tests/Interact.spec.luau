--!nonstrict
-- New Game Kit spec: Interact (server-checked "press E" for doors, seats, job boards, counters).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Interact = require(ReplicatedStorage:WaitForChild("Kit"):WaitForChild("Interact"))

return function()
	describe("Interact", function()
		it("checks distance on the server with a little lag slack", function()
			local g = Interact.new({ range = 10 })
			expect((g:Try(1, "door", { distance = 11.5 }, 0))).to.equal(true)
			local ok, why = g:Try(2, "door", { distance = 13 }, 0)
			expect(ok).to.equal(false)
			expect(why).to.equal("TooFar")
		end)
		it("treats a missing or NaN distance as far", function()
			local g = Interact.new({ range = 10 })
			expect(select(2, g:Try(1, "x", { distance = 0 / 0 }, 0))).to.equal("TooFar")
			expect(select(2, g:Try(1, "x", {}, 0))).to.equal("TooFar")
		end)
		it("makes the same player wait between uses", function()
			local g = Interact.new({ range = 10, cooldown = 0.5 })
			expect((g:Try(1, "a", { distance = 1 }, 10))).to.equal(true)
			expect(select(2, g:Try(1, "b", { distance = 1 }, 10.2))).to.equal("Wait")
			expect((g:Try(1, "b", { distance = 1 }, 10.6))).to.equal(true)
		end)
		it("respects the caller's permission and dead players", function()
			local g = Interact.new({ range = 10 })
			expect(select(2, g:Try(1, "a", { distance = 1, allowed = false }, 0))).to.equal("NotAllowed")
			expect(select(2, g:Try(1, "a", { distance = 1, alive = false }, 0))).to.equal("Dead")
		end)
		it("lets one player hold a busy target until it is released", function()
			local g = Interact.new({ range = 10, busy = true })
			expect((g:Try(1, "seat", { distance = 1 }, 0))).to.equal(true)
			expect(select(2, g:Try(2, "seat", { distance = 1 }, 1))).to.equal("Busy")
			g:Release("seat")
			expect((g:Try(2, "seat", { distance = 1 }, 2))).to.equal(true)
			expect(g:Holder("seat")).to.equal(2)
		end)
		it("frees everything a leaving player held", function()
			local g = Interact.new({ range = 10, busy = true })
			g:Try(7, "stove", { distance = 1 }, 0)
			g:Forget(7)
			expect(g:Holder("stove")).to.equal(nil)
			expect((g:Try(8, "stove", { distance = 1 }, 0))).to.equal(true)
		end)
	end)
end
