--!nonstrict
-- New Game Kit spec: the kit's own services (pure parts). Runs offline with tools/test.luau.
local ServerScriptService = game:GetService("ServerScriptService")
local Server = ServerScriptService:WaitForChild("Kit")

local Upgrades = require(Server.Upgrades)
local Income = require(Server.Income)
local Pets = require(Server.Pets)

return function()
	describe("Upgrades", function()
		local def = { name = "X", currency = "Coins", baseCost = 50, growth = 1.5, maxLevel = 10, effect = { kind = "stat", perLevel = 2, base = 16 } }
		it("costs grow geometrically and round down", function()
			expect(Upgrades.costAt(def, 0)).to.equal(50)
			expect(Upgrades.costAt(def, 1)).to.equal(75)
			expect(Upgrades.costAt(def, 2)).to.equal(112)
		end)
		it("returns math.huge past safe integers", function()
			expect(Upgrades.costAt(def, 1000)).to.equal(math.huge)
		end)
		it("computes stat and multiplier effects", function()
			expect(Upgrades.effectAt(def, 3)).to.equal(22)
			local mult = { name = "M", currency = "Coins", baseCost = 1, growth = 1, maxLevel = 5, effect = { kind = "multiplier", currency = "Coins", perLevel = 0.1 } }
			expect(Upgrades.effectAt(mult, 0)).to.equal(1)
			expect(Upgrades.effectAt(mult, 5)).to.be.near(1.5)
		end)
	end)
	describe("Income.offlineAmount", function()
		it("pays rate x seconds, capped at maxHours", function()
			expect(Income.offlineAmount(10, 100, 0.5, 2)).to.equal(500)
			expect(Income.offlineAmount(10, 10 * 3600, 0.5, 2)).to.equal(10 * 7200 * 0.5)
		end)
		it("pays nothing for zero or negative time", function()
			expect(Income.offlineAmount(10, 0, 0.5, 2)).to.equal(0)
			expect(Income.offlineAmount(10, -50, 0.5, 2)).to.equal(0)
		end)
	end)
	describe("Pets.boostFor", function()
		it("adds each equipped pet's boost once", function()
			expect(Pets.boostFor({ "Dog", "Fox" }, { Dog = 0.1, Fox = 0.5 })).to.be.near(1.6)
			expect(Pets.boostFor({}, { Dog = 0.1 })).to.equal(1)
			expect(Pets.boostFor({ "Unknown" }, { Dog = 0.1 })).to.equal(1)
		end)
	end)
end
