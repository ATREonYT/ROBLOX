--!nonstrict
-- New Game Kit spec: Wanted (heat, stars, fading, arrests). Vault "Realistic City RP/08".
local ServerScriptService = game:GetService("ServerScriptService")
local Wanted = require(ServerScriptService:WaitForChild("Kit"):WaitForChild("Wanted"))

return function()
	describe("Wanted", function()
		it("only players who picked a crime role gain heat", function()
			local civilian = Wanted.new(false, 0)
			expect(Wanted.Crime(civilian, "Robbery", 0)).to.equal(0)
			local w = Wanted.new(true, 0)
			expect(Wanted.Crime(w, "Robbery", 0)).to.equal(3)
			expect(Wanted.Crime(w, "Jaywalking", 1)).to.equal(3)
		end)
		it("fades after 45 s unseen, and a sighting restarts the wait", function()
			local w = Wanted.new(true, 0)
			Wanted.Crime(w, "Robbery", 0)
			expect(Wanted.Stars(w, 45)).to.equal(3)
			expect(Wanted.Stars(w, 65)).to.equal(2)
			Wanted.Seen(w, 65)
			expect(Wanted.Stars(w, 100)).to.equal(2)
			expect(Wanted.Stars(w, 135)).to.equal(0)
		end)
		it("caps at 5 stars", function()
			local w = Wanted.new(true, 0)
			Wanted.Crime(w, "BankJob", 0)
			expect(Wanted.Crime(w, "BankJob", 1)).to.equal(5)
			expect(w.heat).to.equal(100)
		end)
		it("arrests need an on-duty officer, stars and range", function()
			local w = Wanted.new(true, 0)
			expect(select(2, Wanted.CanArrest(w, 0, 2, true))).to.equal("NotWanted")
			Wanted.Crime(w, "Robbery", 0)
			expect(select(2, Wanted.CanArrest(w, 1, 2, false))).to.equal("NotPolice")
			expect(select(2, Wanted.CanArrest(w, 1, 10, true))).to.equal("TooFar")
			expect((Wanted.CanArrest(w, 1, 5, true))).to.equal(true)
			expect(Wanted.Bounty(w, 1)).to.equal(450)
			expect(Wanted.JailSeconds(w, 1)).to.equal(36)
			Wanted.Clear(w)
			expect(Wanted.Stars(w, 2)).to.equal(0)
		end)
		it("keeps jail short: 12 s per star, 10-60 s", function()
			local w = Wanted.new(true, 0)
			Wanted.Crime(w, "BankJob", 0)
			expect(Wanted.JailSeconds(w, 0)).to.equal(60)
			local small = Wanted.new(true, 0)
			Wanted.Crime(small, "Speeding", 0)
			expect(Wanted.JailSeconds(small, 0)).to.equal(12)
		end)
	end)
end
